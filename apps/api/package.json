{
  "name": "@kairos/api",
  "version": "0.1.0",
  "description": "Kairos Ponto - API (NestJS)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "clean": "rm -rf dist .turbo",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@kairos/billing": "workspace:*",
    "@kairos/config": "workspace:*",
    "@kairos/database": "workspace:*",
    "@kairos/face": "workspace:*",
    "@kairos/timesheet": "workspace:*",
    "@kairos/types": "workspace:*",
    "@kairos/utils": "workspace:*",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "date-fns": "^3.6.0",
    "exceljs": "^4.4.0",
    "nodemailer": "^6.9.15",
    "pdfkit": "^0.15.0",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
