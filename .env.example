# =============================================================
# KAIROS PONTO - Environment Variables
# =============================================================
# Copy this file to .env and fill in the real values.
# NEVER commit .env to the repository.
# =============================================================

# ---- General ----
NODE_ENV=development

# ---- Database (PostgreSQL CENTRAL existente) ----
# Connect to the existing PostgreSQL instance on your VPS.
# The database "kairos_ponto" must already exist on that instance.
DATABASE_URL=postgresql://kairos_user:CHANGE_ME@localhost:5432/kairos_ponto

# ---- API (NestJS) ----
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003

# ---- JWT ----
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Web (Admin / Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Kairos Ponto

# ---- Employee PWA ----
NEXT_PUBLIC_EMPLOYEE_API_URL=http://localhost:3001

# ---- Super Admin ----
NEXT_PUBLIC_SUPER_ADMIN_API_URL=http://localhost:3001

# ---- Face Recognition Provider ----
# Options: "face-api-js" (local) | "aws" | "azure" | "mock"
# In MVP, use "face-api-js". Switch to a real provider in production.
FACE_PROVIDER=face-api-js
FACE_API_KEY=
FACE_API_ENDPOINT=
FACE_SIMILARITY_THRESHOLD=0.6

# ---- Storage (for biometric embeddings encryption) ----
# 32-byte key encoded in base64. Generate with: openssl rand -base64 32
BIOMETRIC_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL

# ---- Asaas (Payment Gateway) ----
# BILLING_PROVIDER: asaas | mock (mock não chama API real, bom pra dev)
BILLING_PROVIDER=mock
ASAAS_ENV=sandbox
ASAAS_API_KEY=CHANGE_ME_ASAAS_API_KEY
ASAAS_WEBHOOK_SECRET=CHANGE_ME_ASAAS_WEBHOOK_SECRET

# ---- Notifications ----
# SMTP (used in MVP before push notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@kairosponto.com.br

# ---- PWA ----
NEXT_PUBLIC_PWA_ENABLED=true

# ---- Rate Limiting ----
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ---- Logging ----
LOG_LEVEL=info
